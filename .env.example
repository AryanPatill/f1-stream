# Copy to .env and fill in. .env is gitignored; this file is not.
# Never paste real values into a chat, an issue, or a commit.

# Supabase Postgres, CONNECTION POOLER string (Project Settings -> Database).
# Use the pooler, not the direct connection. Read/write role.
SUPABASE_DB_URL=

# Same database, stream_readonly role. Created in step 3.
# Leave blank until then.
SUPABASE_DB_URL_RO=

# Operator key for the API. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# Session cookie signing secret. Generate separately from APP_API_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Comma-separated CORS allowlist. Never "*".
ALLOWED_ORIGINS=http://127.0.0.1:8000

# Final step only (step 20). Leave blank until then.
ANTHROPIC_API_KEY=